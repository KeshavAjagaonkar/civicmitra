NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=<generate-a-random-64-char-hex-string>
JWT_EXPIRE=7d
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
GEMINI_API_KEY=<your-gemini-api-key>
FRONTEND_URL=http://localhost:5173

# Email Configuration (Gmail SMTP)
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Search for "App passwords"
# 4. Generate password for "Mail"
# 5. Copy the 16-digit password and paste below
EMAIL_SERVICE=gmail
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASS=<your-16-digit-app-password>
EMAIL_FROM="CivicMitra <your-email@gmail.com>"
